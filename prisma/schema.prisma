generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum CategoriaLugar {
  TIPICA
  RAPIDA
}

enum EstadoRecorrido {
  EN_CURSO
  COMPLETADO
}

model Lugar {
  id            Int               @id @default(autoincrement())
  nombre        String            @unique @db.VarChar(80)
  categoria     CategoriaLugar
  descripcion   String?           @db.VarChar(250)
  propietarioId Int?              @unique
  createdAt     DateTime          @default(now())
  propietario   Usuario?          @relation("PropietarioLugar", fields: [propietarioId], references: [id], onDelete: SetNull)
  sucursales    Sucursal[]
  paradas       RutaLugar[]
  sellos        Sello[]
  recompensas   RecompensaLugar[]

  @@index([categoria])
}

model Sucursal {
  id          Int                  @id @default(autoincrement())
  lugarId     Int
  nombre      String               @db.VarChar(80)
  direccion   String               @db.VarChar(150)
  codigoSello String               @unique @db.VarChar(64)
  activa      Boolean              @default(true)
  lugar       Lugar                @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  sellos      Sello[]
  canjes      RecompensaOtorgada[]

  @@index([lugarId])
}

model Ruta {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique @db.VarChar(100)
  descripcion String      @db.VarChar(500)
  activa      Boolean     @default(true)
  paradas     RutaLugar[]
  recompensa  Recompensa?
  recorridos  Recorrido[]
}

model RutaLugar {
  id      Int   @id @default(autoincrement())
  rutaId  Int
  lugarId Int
  orden   Int
  ruta    Ruta  @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  lugar   Lugar @relation(fields: [lugarId], references: [id], onDelete: Restrict)

  @@unique([rutaId, orden])
  @@unique([rutaId, lugarId])
}

model Recompensa {
  id           Int                  @id @default(autoincrement())
  rutaId       Int                  @unique
  nombre       String               @db.VarChar(120)
  porcentaje   Int                  @default(10)
  producto     String?              @db.VarChar(160)
  diasVigencia Int                  @default(30)
  ruta         Ruta                 @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  lugares      RecompensaLugar[]
  otorgadas    RecompensaOtorgada[]
}

model RecompensaLugar {
  recompensaId Int
  lugarId      Int
  recompensa   Recompensa @relation(fields: [recompensaId], references: [id], onDelete: Cascade)
  lugar        Lugar      @relation(fields: [lugarId], references: [id], onDelete: Cascade)

  @@id([recompensaId, lugarId])
}

model Usuario {
  id           Int         @id @default(autoincrement())
  email        String      @unique @db.VarChar(254)
  passwordHash String      @db.VarChar(255)
  rolId        Int
  createdAt    DateTime    @default(now())
  rol          Rol         @relation(fields: [rolId], references: [id], onDelete: Restrict)
  lugar        Lugar?      @relation("PropietarioLugar")
  recorridos   Recorrido[]
}

model Recorrido {
  id          Int                 @id @default(autoincrement())
  usuarioId   Int
  rutaId      Int
  estado      EstadoRecorrido     @default(EN_CURSO)
  fechaInicio DateTime            @default(now())
  fechaFin    DateTime?
  usuario     Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ruta        Ruta                @relation(fields: [rutaId], references: [id], onDelete: Restrict)
  sellos      Sello[]
  recompensa  RecompensaOtorgada?

  @@index([usuarioId, rutaId, estado])
  @@index([rutaId, estado])
}

model Sello {
  id          Int       @id @default(autoincrement())
  recorridoId Int
  lugarId     Int
  sucursalId  Int?
  orden       Int
  fecha       DateTime  @default(now())
  recorrido   Recorrido @relation(fields: [recorridoId], references: [id], onDelete: Cascade)
  lugar       Lugar     @relation(fields: [lugarId], references: [id], onDelete: Restrict)
  sucursal    Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)

  @@unique([recorridoId, lugarId])
  @@unique([recorridoId, orden])
  @@index([lugarId, fecha])
  @@index([sucursalId])
}

model RecompensaOtorgada {
  id               Int        @id @default(autoincrement())
  recorridoId      Int        @unique
  recompensaId     Int
  codigoCanje      String     @unique @db.VarChar(64)
  fechaOtorgada    DateTime   @default(now())
  fechaVencimiento DateTime
  canjeada         Boolean    @default(false)
  fechaCanje       DateTime?
  sucursalCanjeId  Int?
  recorrido        Recorrido  @relation(fields: [recorridoId], references: [id], onDelete: Cascade)
  recompensa       Recompensa @relation(fields: [recompensaId], references: [id], onDelete: Restrict)
  sucursalCanje    Sucursal?  @relation(fields: [sucursalCanjeId], references: [id], onDelete: SetNull)

  @@index([sucursalCanjeId])
}

model Rol {
  id       Int          @id @default(autoincrement())
  nombre   String       @unique @db.VarChar(40)
  usuarios Usuario[]
  permisos RolPermiso[]
}

model Permiso {
  id          Int          @id @default(autoincrement())
  clave       String       @unique @db.VarChar(80)
  descripcion String       @db.VarChar(200)
  roles       RolPermiso[]
}

model RolPermiso {
  rolId     Int
  permisoId Int
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([permisoId])
}
